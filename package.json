{
  "name": "codingkidadesktop",
  "version": "1.0.0",
  "description": "CodingKida Desktop App built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.codingkida.desktop",
    "productName": "CodingKida",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "src/renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
