{
  "name": "codingkidadesktop",
  "version": "1.0.0",
  "description": "CodingKida Desktop App built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.codingkida.desktop",
    "productName": "CodingKida",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "natwarjha2-tech",
      "repo": "codingkidadesktop"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "follow-redirects": "^1.16.0"
  }
}
